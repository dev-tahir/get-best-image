  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@types/node": "^24.3.1",
    "axios": "^1.11.0",
    "canvas": "^3.2.0",
    "dotenv": "^17.2.2",
    "sharp": "^0.34.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "uuid": "^12.0.0"
  }
}
