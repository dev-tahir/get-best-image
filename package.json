{
  "name": "mcp-image-server",
  "version": "1.0.0",
  "description": "MCP server for intelligent image search and selection using AI",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsx src/index.ts",
    "watch": "tsx --watch src/index.ts",
