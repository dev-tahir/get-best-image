# Google AI API Key for Gemini 2.0 Flash (required for AI image selection)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# Image Search API Keys (at least one is recommended)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
PEXELS_API_KEY=your_pexels_api_key_here

# Configuration
MAX_IMAGES=20
TIMEOUT_MS=15000
